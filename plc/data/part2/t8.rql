LET @foo = <foo.ttl>

CONSTRUCT { ?x <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://xmlns.com/foaf/0.1/Person> }
WHERE {
  { @foo { ?x <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://xmlns.com/foaf/0.1/Person> } }
  EXCEPT
  { @foo { ?x <http://xmlns.com/foaf/0.1/knows> <http://example.org/nmg> } }
}

